<resources>
    <style name="Theme.Clipper" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item><item name="colorOnPrimary">@color/dark</item>
        <item name="colorSecondary">@color/accent</item><item name="colorSurface">@color/surface</item>
        <item name="colorSecondaryContainer">#35482A</item><item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorPrimaryContainer">#35482A</item><item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="android:colorBackground">@color/background</item><item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item><item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item><item name="colorOutline">@color/line</item>
    </style>
    <style name="SectionTitle"><item name="android:textSize">20sp</item><item name="android:textColor">@color/text</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="BodyText"><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingExtra">4dp</item></style>
    <style name="Card"><item name="android:background">@drawable/bg_card</item><item name="android:padding">20dp</item></style>
</resources>
